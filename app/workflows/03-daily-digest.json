{
 "name": "Daily AI news digest",
 "nodes": [
  {
   "id": "c1",
   "name": "Every morning",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ],
   "parameters": {
    "rule": {
     "interval": [
      {
       "triggerAtHour": 8
      }
     ]
    }
   }
  },
  {
   "id": "c2",
   "name": "News agent",
   "type": "@n8n/n8n-nodes-langchain.agent",
   "typeVersion": 3.1,
   "position": [
    260,
    0
   ],
   "parameters": {
    "promptType": "define",
    "text": "Get the 15 stories on the Hacker News front page right now. Pick the 3 that matter most to developers who build with AI, and write a digest: one short line per story, with its title and why it matters.",
    "options": {
     "systemMessage": "You are a tech news editor. Be concise. Write plain text: no links, no markdown. Only use stories returned by your tools; never invent one."
    }
   }
  },
  {
   "id": "c3",
   "name": "OpenAI Chat Model",
   "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
   "typeVersion": 1.3,
   "position": [
    160,
    240
   ],
   "parameters": {
    "model": {
     "__rl": true,
     "mode": "list",
     "value": "gpt-6-luna",
     "cachedResultName": "gpt-6-luna"
    },
    "options": {}
   },
   "credentials": {
    "openAiApi": {
     "id": "Txb1XFp6UBMEzNy8",
     "name": "OpenAI account"
    }
   }
  },
  {
   "id": "c4",
   "name": "Hacker News",
   "type": "n8n-nodes-base.hackerNewsTool",
   "typeVersion": 1,
   "position": [
    380,
    240
   ],
   "parameters": {
    "resource": "all",
    "limit": 15,
    "additionalFields": {
     "tags": [
      "front_page"
     ]
    }
   }
  },
  {
   "id": "c5",
   "name": "Save digest",
   "type": "n8n-nodes-base.dataTable",
   "typeVersion": 1.1,
   "position": [
    620,
    0
   ],
   "parameters": {
    "dataTableId": {
     "__rl": true,
     "mode": "list",
     "value": "ylwikR97KCrZAwJe",
     "cachedResultName": "daily_digest"
    },
    "columns": {
     "mappingMode": "defineBelow",
     "value": {
      "day": "={{ $now.toFormat('yyyy-MM-dd') }}",
      "digest": "={{ $json.output }}"
     },
     "matchingColumns": [],
     "schema": [
      {
       "id": "day",
       "displayName": "day",
       "required": false,
       "defaultMatch": false,
       "display": true,
       "type": "string",
       "readOnly": false,
       "removed": false
      },
      {
       "id": "digest",
       "displayName": "digest",
       "required": false,
       "defaultMatch": false,
       "display": true,
       "type": "string",
       "readOnly": false,
       "removed": false
      }
     ]
    },
    "options": {}
   }
  }
 ],
